# Copy to .env and fill in real values. .env is git-ignored; never commit it.
PORT=5000
CORS_ORIGIN=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGDATABASE=project_timesheet
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# Long random string (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
# Token lifetime for a normal sign-in, and for "Remember me"
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d

# OT policy assistant (optional). Answers overtime questions from approved policy documents using Claude.
# Leave empty to disable the assistant. The approved documents and live policy settings are sent to Anthropic's API.
ANTHROPIC_API_KEY=
# OT_ASSISTANT_MODEL=claude-opus-5-5
