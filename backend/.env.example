# Copy to .env and fill in real values. .env is git-ignored; never commit it.
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas. Copy the connection string from Atlas → Connect → Drivers and replace <db_password>.
# SMONGODB_URI=mongodb+srv://hemareddyvadlakondav879_db_user:TimeSheet%40Cloud2026%21Shimento@cluster1.qqqyp3j.mongodb.net/?retryWrites=true&w=majoritypecial characters in the username or password must be URL-encoded: @ → %40, : → %3A, / → %2F, # → %23, % → %25
MONGODB_URI=mongodb+srv://hemareddyvadlakondav879_db_user:TimeSheet%40Cloud2026%21Shimento@cluster1.qqqyp3j.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=project_timesheet

# Long random string (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
# Token lifetime for a normal sign-in, and for "Remember me"
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d

# Legacy PostgreSQL database. Only needed while migrating existing records into MongoDB;
# remove these once the migration has been verified.

