# Copy to .env and fill in real values. .env is git-ignored; never commit it.
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas. Copy the connection string from Atlas → Connect → Drivers and replace <db_password>.
# SMONGODB_URI=mongodb+srv://hemareddyvadlakondav879_db_user:TimeSheet%40Cloud2026%21Shimento@cluster1.qqqyp3j.mongodb.net/?retryWrites=true&w=majoritypecial characters in the username or password must be URL-encoded: @ → %40, : → %3A, / → %2F, # → %23, % → %25
MONGODB_URI=mongodb+srv://hemareddyvadlakondav879_db_user:TimeSheet%40Cloud2026%21Shimento@cluster1.qqqyp3j.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=project_timesheet

# Long random string (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
# Token lifetime for a normal sign-in, and for "Remember me"
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d

# Legacy PostgreSQL database. Only needed while migrating existing records into MongoDB;
# remove these once the migration has been verified.


# Public addresses. APP_PUBLIC_URL is where the frontend is served (defaults to CORS_ORIGIN);
# API_PUBLIC_URL is where the browser reaches this API (defaults to http://localhost:<PORT>).
# APP_PUBLIC_URL=
# API_PUBLIC_URL=

# LMS ("My LMS" in the sidebar). LMS_SSO_SECRET must be at least 32 characters and equal to
# LMS_SSO_SECRET in lms/backend/.env, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LMS_URL=http://localhost:5007
LMS_SSO_SECRET=

# "Sign in with Keka account". Your Keka web address is https://<KEKA_COMPANY>.keka.com. Get the SSO client from Keka
# Support ("Keka as Identity Provider") and register <API_PUBLIC_URL>/api/auth/keka/callback as the redirect address.
KEKA_COMPANY=
# keka for the live account, kekademo for Keka's sandbox
KEKA_ENVIRONMENT=keka
KEKA_SSO_CLIENT_ID=
KEKA_SSO_CLIENT_SECRET=
# Only if Keka asks for a different callback address than the default above.
KEKA_SSO_REDIRECT_URI=
# Optional Keka HRIS API credentials: when set, only employees Keka marks "Working" can sign in.
KEKA_API_CLIENT_ID=
KEKA_API_CLIENT_SECRET=
KEKA_API_KEY=
