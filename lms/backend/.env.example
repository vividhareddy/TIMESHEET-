# Copy this file to backend/.env and fill in the values. backend/.env is private and never committed.
# Restart the server after changing it.

# Public origin of the LMS (used for Keka sign-in and certificate links), e.g. https://timesheet.yourcompany.com.
# Origin only: when the timesheet server proxies the LMS under /lms, that path is added automatically (LMS_BASE_PATH).
LMS_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- AI (Claude API)
# Turns on the AI learning assistant and "Create from a link with AI" in Manage Courses.
# Also needs the SDK on the server: pip install anthropic
# Using these features is billed by Anthropic; see docs/ai-assistant.md.
LMS_AI_ENABLED=0
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Keka
# Your Keka web address is https://<KEKA_COMPANY>.keka.com
KEKA_COMPANY=
# keka for the live account, kekademo for Keka's sandbox
KEKA_ENVIRONMENT=keka

# "Sign in with Keka account": SSO client details from Keka Support ("Keka as Identity Provider").
# Register this redirect URI with Keka: <LMS_PUBLIC_BASE_URL>/lms/api/auth/keka/callback (without /lms when run on its own)
KEKA_SSO_CLIENT_ID=
KEKA_SSO_CLIENT_SECRET=
# Only if Keka asks for a different callback address than the default above.
KEKA_SSO_REDIRECT_URI=

# Keka HRIS API credentials (Keka admin > Integrations & Automation > API access).
# Used to copy each employee's Keka details (name, job title, employee number, manager, status) into the LMS.
KEKA_API_CLIENT_ID=
KEKA_API_CLIENT_SECRET=
KEKA_API_KEY=

# ---------------------------------------------------------------- Timesheet single sign-on
# People sign in on the Timesheet portal and open the LMS from "My LMS" in its sidebar.
# LMS_SSO_SECRET must equal LMS_SSO_SECRET in the timesheet's backend/.env (at least 32 characters).
# Leave it empty to use the LMS's own sign-in page instead.
TIMESHEET_URL=http://localhost:5032
LMS_SSO_SECRET=

# ---------------------------------------------------------------- MongoDB
# The LMS stores its data in MongoDB, in the timesheet's database (collections prefixed lms_).
# When these are empty, MONGODB_URI and MONGODB_DB_NAME are read from the timesheet's backend/.env.
LMS_MONGODB_URI=
LMS_MONGODB_DB=
# LMS_COLLECTION_PREFIX=lms_
